#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -f "$SCRIPT_DIR/docker-compose.yml" ]]; then
  ROOT_DIR="$SCRIPT_DIR"
else
  ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
fi
ENV_FILE="$ROOT_DIR/.env"
COMPOSE_FILE="$ROOT_DIR/docker-compose.yml"
BACKUP_DIR="$ROOT_DIR/backups"

info() { printf '[RepoNest] %s\n' "$*"; }
warn() { printf '[RepoNest] WARNING: %s\n' "$*" >&2; }
die() { printf '[RepoNest] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
RepoNest control utility

Usage: ./reponestctl <command> [arguments]

  start                    Start the application
  stop                     Stop the application without deleting data
  restart                  Restart the application
  status                   Show container status
  logs                     Follow application logs
  health                   Check the public application and embedded database
  update [image-tag]       Back up, pull, restart, and verify
  backup [filename]        Create an offline database backup
  restore <backup.tar.gz>  Restore a backup with automatic rollback
  doctor                   Validate configuration, storage, and health
  help                     Show this message
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

compose() {
  docker compose \
    --project-directory "$ROOT_DIR" \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" "$@"
}

env_value() {
  local key="$1" fallback="$2" value
  value="$(awk -F= -v wanted="$key" '
    $0 !~ /^[[:space:]]*#/ && $1 == wanted {
      sub(/^[^=]*=/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit
    }
  ' "$ENV_FILE")"
  value="${value%\"}"; value="${value#\"}"
  printf '%s' "${value:-$fallback}"
}

set_env_value() {
  local key="$1" value="$2" temp
  temp="$(mktemp "$ROOT_DIR/.env.XXXXXX")"
  awk -F= -v wanted="$key" -v replacement="$value" '
    BEGIN { found = 0 }
    $1 == wanted { print wanted "=" replacement; found = 1; next }
    { print }
    END { if (!found) print wanted "=" replacement }
  ' "$ENV_FILE" > "$temp"
  chmod 600 "$temp"
  mv -f "$temp" "$ENV_FILE"
}

data_dir() {
  local configured
  configured="$(env_value REPONEST_DATA_DIR ./data)"
  if [[ "$configured" = /* ]]; then
    printf '%s' "$configured"
  else
    printf '%s/%s' "$ROOT_DIR" "${configured#./}"
  fi
}

ensure_layout() {
  [[ -f "$ENV_FILE" ]] || die "Missing $ENV_FILE. Copy .env.example to .env and configure it."
  [[ -f "$COMPOSE_FILE" ]] || die "Missing $COMPOSE_FILE."
  local storage
  storage="$(data_dir)"
  [[ -n "$storage" && "$storage" != "/" ]] || die "Unsafe data directory: $storage"
  mkdir -p "$storage/database" "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
}

validate_config() {
  compose config --quiet || die "Invalid Compose configuration. Check $ENV_FILE."
}

is_running() {
  [[ -n "$(compose ps --status running -q app 2>/dev/null)" ]]
}

start() {
  ensure_layout
  validate_config
  compose up -d --remove-orphans --wait --wait-timeout 180
  compose ps
}

health() {
  ensure_layout
  validate_config
  is_running || die "RepoNest is not running."
  compose exec -T app wget -qO- http://127.0.0.1:3000/api/health
  printf '\n'
  info "Application and database are healthy."
}

create_backup() {
  local requested="${1:-}" restart_after="${2:-true}"
  local storage timestamp destination partial was_running=false
  storage="$(data_dir)"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  [[ -d "$storage/database" ]] || die "Database directory not found: $storage/database"
  if [[ -n "$requested" ]]; then
    if [[ "$requested" = /* ]]; then destination="$requested"; else destination="$BACKUP_DIR/$requested"; fi
  else
    destination="$BACKUP_DIR/reponest-$timestamp.tar.gz"
  fi
  [[ "$destination" == *.tar.gz ]] || destination="$destination.tar.gz"
  partial="$destination.partial"
  mkdir -p "$(dirname -- "$destination")"
  umask 077

  if is_running; then
    was_running=true
    info "Stopping RepoNest for a consistent backup..."
    compose stop --timeout 30 app
  fi

  info "Creating backup..."
  if ! tar -C "$storage" -czf "$partial" database; then
    rm -f -- "$partial"
    if [[ "$was_running" == true ]]; then compose start app; fi
    die "Backup failed."
  fi
  [[ -s "$partial" ]] || die "Backup file is empty."
  mv -f -- "$partial" "$destination"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$destination" > "$destination.sha256"
  fi
  if [[ "$was_running" == true && "$restart_after" == true ]]; then
    start >/dev/null
    health >/dev/null
  fi
  info "Backup ready: $destination"
}

restore() {
  local source="${1:-}" storage stage previous timestamp
  [[ -n "$source" ]] || die "Usage: ./reponestctl restore <backup.tar.gz>"
  [[ -f "$source" ]] || source="$BACKUP_DIR/$source"
  [[ -f "$source" ]] || die "Backup not found: $source"
  if ! tar -tzf "$source" | awk '
      /(^|\/)\.\.($|\/)/ { bad = 1 }
      $0 != "database" && $0 != "database/" && $0 !~ /^database\// { bad = 1 }
      END { exit bad }
    '; then
    die "Backup contains an unsafe or unexpected path."
  fi

  warn "Restore replaces the current RepoNest database."
  printf 'Type RESTORE to continue: '
  read -r confirmation
  [[ "$confirmation" == "RESTORE" ]] || die "Restore cancelled."

  ensure_layout
  create_backup "pre-restore-$(date -u +%Y%m%dT%H%M%SZ).tar.gz" false
  compose stop --timeout 30 app >/dev/null 2>&1 || true
  storage="$(data_dir)"
  stage="$(mktemp -d "$ROOT_DIR/.restore.XXXXXX")"
  tar -xzf "$source" -C "$stage"
  [[ -n "$(find "$stage/database" -mindepth 1 -maxdepth 1 -print -quit)" ]] || die "Backup database is empty."

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  previous="$storage/database.before-restore-$timestamp"
  mv "$storage/database" "$previous"
  mv "$stage/database" "$storage/database"
  rmdir "$stage"

  if start >/dev/null && health >/dev/null; then
    [[ "$previous" == "$storage"/* && "$previous" != "$storage" ]] || die "Unsafe restore cleanup path."
    rm -rf -- "$previous"
    info "Restore completed and verified."
    return
  fi

  warn "The restored database did not start. Rolling back automatically."
  compose stop --timeout 30 app >/dev/null 2>&1 || true
  mv "$storage/database" "$storage/database.failed-$timestamp"
  mv "$previous" "$storage/database"
  start >/dev/null
  die "Restore failed; the previous database was restored."
}

update() {
  local tag="${1:-}" was_running=false
  ensure_layout
  validate_config
  if [[ -n "$tag" ]]; then
    [[ "$tag" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid image tag: $tag"
    set_env_value REPONEST_VERSION "$tag"
    info "Pinned image tag to $tag."
  fi
  if is_running; then
    was_running=true
    create_backup "" false
  fi
  info "Pulling the RepoNest image..."
  if ! compose pull app; then
    if [[ "$was_running" == true ]]; then start >/dev/null; fi
    die "Image pull failed; the existing application was restarted."
  fi
  start >/dev/null
  health
  info "Update completed."
}

doctor() {
  require_command docker
  docker info >/dev/null 2>&1 || die "Docker daemon is unavailable."
  docker compose version
  ensure_layout
  validate_config
  [[ "$(compose config --services | wc -l | tr -d ' ')" == "1" ]] || die "RepoNest must define exactly one service."
  info "Deployment directory: $ROOT_DIR"
  info "Persistent data: $(data_dir)"
  df -h "$ROOT_DIR" | tail -n 1
  compose ps
  if is_running; then health; fi
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  start) require_command docker; start ;;
  stop) require_command docker; ensure_layout; compose stop ;;
  restart) require_command docker; ensure_layout; compose restart; compose up -d --wait --wait-timeout 180; health ;;
  status) require_command docker; ensure_layout; compose ps ;;
  logs) require_command docker; ensure_layout; compose logs --tail=200 -f app ;;
  health) require_command docker; health ;;
  update) require_command docker; shift; update "${1:-}" ;;
  backup) require_command docker; require_command tar; shift; create_backup "${1:-}" true ;;
  restore) require_command docker; require_command tar; shift; restore "${1:-}" ;;
  doctor) doctor ;;
  *) usage >&2; die "Unknown command: $1" ;;
esac
