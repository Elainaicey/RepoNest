# Container images and loopback ports
REPONEST_VERSION=latest
REPONEST_WEB_PORT=3000
REPONEST_API_PORT=4000

# Public HTTPS origin (no trailing slash)
PUBLIC_URL=https://reponest.example.com
GITHUB_CALLBACK_URL=https://reponest.example.com/api/auth/github/callback

# GitHub App credentials
GITHUB_CLIENT_ID=Iv23li_your_client_id
GITHUB_CLIENT_SECRET=replace_with_your_client_secret
GITHUB_API_VERSION=2026-03-10

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# PostgreSQL
POSTGRES_USER=reponest
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=reponest

# Sync up to 5,000 stars every hour
SYNC_INTERVAL_MINUTES=60
MAX_SYNC_PAGES=50
