# Container image and loopback port
REPONEST_VERSION=latest
REPONEST_PORT=3000

# Public HTTPS origin (no trailing slash)
PUBLIC_URL=https://reponest.example.com

# GitHub App credentials
GITHUB_CLIENT_ID=Iv23li_your_client_id
GITHUB_CLIENT_SECRET=replace_with_your_client_secret
GITHUB_API_VERSION=2026-03-10

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Relative paths resolve from the directory containing docker-compose.yml.
REPONEST_DATA_DIR=./data

# Session and GitHub synchronization
SESSION_TTL_DAYS=30
SYNC_INTERVAL_MINUTES=60
MAX_SYNC_PAGES=50
COOKIE_SECURE=true

# Docker JSON log rotation
REPONEST_LOG_MAX_SIZE=10m
REPONEST_LOG_MAX_FILES=3
