{
  "name": "reponest",
  "version": "0.1.0",
  "description": "A local-first, self-hosted GitHub stars and developer bookmarks manager.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Elainaicey/RepoNest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elainaicey/RepoNest.git"
  },
  "bugs": {
    "url": "https://github.com/Elainaicey/RepoNest/issues"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "npm run dev --prefix server",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:api": "npm run build --prefix server",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:api": "npm test --prefix server",
    "typecheck:api": "npm run typecheck --prefix server",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern server/dist"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
