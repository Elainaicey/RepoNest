{
  "name": "reponest",
  "version": "0.1.0",
  "description": "A self-hosted workspace for organizing GitHub stars, bookmarks, tags, notes, and collections.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Elainaicey/RepoNest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elainaicey/RepoNest.git"
  },
  "bugs": {
    "url": "https://github.com/Elainaicey/RepoNest/issues"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vinext dev",
    "dev:api": "npm run dev --prefix server",
    "build": "npm run clean && vinext build",
    "build:api": "npm run build --prefix server",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:api": "npm test --prefix server",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "npm run typecheck --prefix server",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern server/dist"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0"
  },
  "type": "module"
}
